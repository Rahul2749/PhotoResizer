# Server-only file. Copy to .env.api, chmod 600; never paste actual values in chat.
NODE_ENV=production
APP_ORIGIN=https://photoresizekaro.in
PORT=3000
TRUST_PROXY=true
PAYMENTS_DATABASE_NAME=photoresizekaro
# Use the database container hostname on its verified Docker network, not 127.0.0.1.
DATABASE_URL=postgresql://photoresizekaro:REPLACE_WITH_URL_ENCODED_PASSWORD@taskmanager-db-1:5432/photoresizekaro
PAYMENTS_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
PAYMENTS_MODE=disabled
PAYMENTS_LIVE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_ACCOUNT_ID=
# Voluntary support is separate from paid passes; no charitable/tax deduction claim.
DONATIONS_ENABLED=true
USAGE_METRICS_ENABLED=true
# Set both on the server to seed the single admin. Password must be 16–256 characters.
# Leave empty to disable admin access. Never use NEXT_PUBLIC_ for these values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
