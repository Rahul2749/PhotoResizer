{
  "name": "photoresizekaro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "preview:lan": "node scripts/serve.mjs --lan",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/image-core.test.ts tests/presets.test.ts tests/inspect-image.test.ts tests/payment-security.test.mjs",
    "test:payments": "node --test --test-concurrency=1 tests/payments.test.mjs tests/admin.test.mjs",
    "api:start": "node api/server.mjs",
    "api:migrate": "node api/migrate.mjs",
    "test:browser": "playwright test",
    "check:production": "node scripts/verify-production.mjs",
    "check:seo": "node scripts/verify-seo.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "next": "16.4.5",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
