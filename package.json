{
  "name": "photoresizekaro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "preview:lan": "node scripts/serve.mjs --lan",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/image-core.test.ts tests/presets.test.ts tests/inspect-image.test.ts",
    "test:browser": "playwright test",
    "check:production": "node scripts/verify-production.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
